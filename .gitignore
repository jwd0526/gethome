# Repo-wide ignores for the minigames monorepo.
# Applies to every minigame directory — do not add per-game .gitignore files.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Package manager noise. NOTE: package-lock.json is deliberately NOT ignored —
# it pins the toolchain and belongs in the repo.
.npm/
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# dist/ is generated by `npm run build` and is fully reproducible from src/.
# If you want the single-file builds (dist/trade-war.html, dist/balance.html)
# downloadable straight from the repo for playtesters, delete the `dist/` line
# below — they are small, self-contained, and there is a real argument for it.
dist/
build/
out/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Test & tooling artifacts
# ---------------------------------------------------------------------------
# NOTE: screenshots/ is NOT ignored — those images are referenced by the READMEs
# and are documentation, not artifacts.
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.playwright/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ---------------------------------------------------------------------------
# Secrets and local configuration — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
secrets.json
.netrc
.npmrc
.htpasswd

# Local agent/editor config that is per-developer, not per-project.
.claude/settings.local.json
.vscode/settings.json
.vscode/launch.json
.idea/workspace.xml

# ---------------------------------------------------------------------------
# Logs, dumps, crash reports
# ---------------------------------------------------------------------------
*.log
logs/
*.pid
*.pid.lock
*.seed
core
*.stackdump
report.*.json

# ---------------------------------------------------------------------------
# Temporary / scratch
# ---------------------------------------------------------------------------
tmp/
temp/
.tmp/
scratch/
scratchpad/
*.tmp
*.bak
*.orig
*.rej
# Throwaway scripts of the form .shot.mjs / .verify.mjs used while iterating.
.*.mjs

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
# Duplicated from a personal global gitignore on purpose: a fresh clone on
# someone else's machine should be protected without relying on their setup.
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon?
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.directory
.Trash-*
.fuse_hidden*
.nfs*

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
*~
*.swp
*.swo
*.swn
.*.sw[a-p]
Session.vim
.netrwhist
\#*\#
.\#*
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
.history/
.vs/

# ---------------------------------------------------------------------------
# Python (the dev server is `python3 -m http.server`)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------------------
# Future Unreal port — see PORTING-TO-UNREAL.md.
# Uncomment when C++/UE4 sources land in this repo.
# ---------------------------------------------------------------------------
# Binaries/
# DerivedDataCache/
# Intermediate/
# Saved/
# .vs/
# *.VC.db
# *.opensdf
# *.sdf
# *.sln
# *.suo
# *.xcodeproj/
# *.xcworkspace/
